parameters:
	ignoreErrors:
		-
			message: '#^Parameter \#2 \$values of method Illuminate\\Http\\JsonResponse\:\:header\(\) expects array\|string, int given\.$#'
			identifier: argument.type
			count: 1
			path: app/Http/Controllers/Auth/AuthController.php

		-
			message: '#^Access to an undefined property App\\Models\\SaleItem\:\:\$boxes_sold\.$#'
			identifier: property.notFound
			count: 1
			path: app/Http/Controllers/Dashboard/DashboardController.php

		-
			message: '#^Access to an undefined property App\\Models\\SaleItem\:\:\$quantity_sold\.$#'
			identifier: property.notFound
			count: 1
			path: app/Http/Controllers/Dashboard/DashboardController.php

		-
			message: '#^Access to an undefined property App\\Models\\SaleItem\:\:\$revenue\.$#'
			identifier: property.notFound
			count: 1
			path: app/Http/Controllers/Dashboard/DashboardController.php

		-
			message: '#^Using nullsafe property access "\?\-\>code" on left side of \?\? is unnecessary\. Use \-\> instead\.$#'
			identifier: nullsafe.neverNull
			count: 1
			path: app/Http/Controllers/Quote/QuoteController.php

		-
			message: '#^Using nullsafe property access "\?\-\>name" on left side of \?\? is unnecessary\. Use \-\> instead\.$#'
			identifier: nullsafe.neverNull
			count: 1
			path: app/Http/Controllers/Quote/QuoteController.php

		-
			message: '#^Using nullsafe property access on non\-nullable type App\\Models\\UnitType\. Use \-\> instead\.$#'
			identifier: nullsafe.neverNull
			count: 1
			path: app/Http/Resources/Inventory/ProductVariantResource.php
